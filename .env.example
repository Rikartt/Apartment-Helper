ANTHROPIC_API_KEY=

# --- Phone alerts (all optional; nothing set = no notifications) ---
# One digest per ingest run (max 5 listings) goes only to you, never to landlords.
# ntfy.sh push: install the ntfy app, subscribe to a long random topic, put it here.
WGP_NTFY_TOPIC=
#WGP_NTFY_SERVER=https://ntfy.sh
# Telegram bot (create via @BotFather; chat id from @userinfobot):
WGP_TELEGRAM_TOKEN=
WGP_TELEGRAM_CHAT_ID=
# Minimum fit score to alert on (default 75) and quiet hours (local time, digest held):
#WGP_NOTIFY_MIN_FIT=75
#WGP_NOTIFY_QUIET=23-07   # default; set empty to disable
